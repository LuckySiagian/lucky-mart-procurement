# Copy to .env and adjust. Never commit the real .env.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174

DB_PASSWORD=postgres

# Password for the demo users created by `python manage.py seed_demo`
DEMO_PASSWORD=change-me-demo-pass

# Lucky Mart service account (a user with a warehouse role in Lucky Mart)
LUCKY_MART_API_URL=http://host.docker.internal:8080
LUCKY_MART_PHONE_NUMBER=
LUCKY_MART_PASSWORD=
